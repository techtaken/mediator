SUPABASE_URL=https://.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_key_here
SUPABASE_SECRET_KEY=your_service_role_key_here
SUPABASE_JWKS_URL=https://.supabase.co/auth/v1/.well-known/jwks.json
GEMINI_API_KEY=your_gemini_api_key
# Required. Encrypts private chats at rest. Make one with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep a copy somewhere safe: losing it makes every private chat unreadable.
DATA_ENCRYPTION_KEY=
# Older keys, comma-separated, kept after a rotation so older rows still open.
DATA_ENCRYPTION_OLD_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
GEMINI_TIMEOUT_MS=30000
ADMIN_EMAILS=

# Estimated USD per million tokens, for the admin cost estimate only.
GEMINI_PRICE_INPUT_PER_M=0.10
GEMINI_PRICE_OUTPUT_PER_M=0.40

# In-process rate limits (per backend instance). 0 disables one.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SESSIONS_PER_HOUR=10
RATE_LIMIT_MESSAGES_PER_MINUTE=12
RATE_LIMIT_WRITES_PER_MINUTE=30
# Unused invite links stop working after this many days.
INVITE_TTL_DAYS=14
# The invited person's PIN: how long a correct one opens the room, and how many
# wrong tries lock entry for how long.
PIN_ACCESS_TTL_MINUTES=120
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=15
# true: ask the orchestrator model where each private-chat turn goes (slower).
PRIVATE_ORCHESTRATOR=false

# Retention. Rooms older than RETENTION_DAYS are removed by the retention job (0 = never).
RETENTION_DAYS=180
AUDIT_REASON_RETENTION_DAYS=30
# Secret a scheduler sends as the X-Job-Token header to POST /api/jobs/*.
JOB_TOKEN=

# Days until the post-agreement check-in when a signer doesn't pick one.
FOLLOWUP_DEFAULT_DAYS=14
# Live-update (server-sent events) streams close after this; browsers reconnect.
SSE_MAX_SECONDS=300
